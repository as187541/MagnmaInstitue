{
  "name": "magnma-institute",
  "version": "2.0.0",
  "private": true,
  "description": "Magnma Institute - Microservices Architecture with Supabase",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api-colleges\" \"npm run dev:api-courses\" \"npm run dev:api-contact\"",
    "dev:frontend": "npm run dev -w packages/frontend",
    "dev:api-colleges": "npx -w packages/api-colleges tsx src/index.ts",
    "dev:api-courses": "npx -w packages/api-courses tsx src/index.ts",
    "dev:api-contact": "npx -w packages/api-contact tsx src/index.ts",
    "build": "npm run build -w packages/frontend",
    "start": "npm run start -w packages/frontend",
    "supabase:seed": "npx ts-node supabase/seed.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1"
  }
}
